#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <string.h>

#define MAX_INPUT 1024

int main() {
    char input[MAX_INPUT];
    char *args[64];
    pid_t pid;
    int status;

    printf("=== Simple Linux Command Executor Demo ===\n");
    printf("Enter a Linux command with arguments (e.g., ls -l, uname -a, lscpu):\n");
    printf("Type 'exit' to quit.\n\n");

    while (1) {
        printf("my_shell> ");
        fflush(stdout);

        // Read user input
        if (fgets(input, sizeof(input), stdin) == NULL) {
            perror("fgets failed");
            break;
        }

        // Remove trailing newline character
        input[strcspn(input, "\n")] = 0;

        // Skip empty input
        if (strlen(input) == 0) {
            continue;
        }

        // Check for exit command
        if (strcmp(input, "exit") == 0) {
            printf("Exiting shell demo. Goodbye!\n");
            break;
        }

        // Parse input into tokens (command and arguments)
        int i = 0;
        char *token = strtok(input, " ");
        while (token != NULL && i < 63) {
            args[i++] = token;
            token = strtok(NULL, " ");
        }
        args[i] = NULL; // Null-terminate the argument array

        // Requirement 5: Display Parent PID before forking
        printf("[Parent] My PID is: %d\n", getpid());

        // Requirement 2: Create a child process using fork()
        pid = fork();

        if (pid < 0) {
            // Fork failed
            perror("Fork failed");
            exit(1);
        } 
        else if (pid == 0) {
            // --- CHILD PROCESS ---
            // Requirement 5: Display Child PID and Parent PID from child's perspective
            printf("[Child] Process created successfully.\n");
            printf("[Child] My PID: %d, My Parent's PID: %d\n", getpid(), getppid());
            
            // Requirement 3: Execute the command using an appropriate exec() system call
            // execvp searches for the executable in the PATH environment variable
            if (execvp(args[0], args) == -1) {
                perror("Command execution failed");
            }
            
            // If execvp returns, it means an error occurred
            exit(EXIT_FAILURE);
        } 
        else {
            // --- PARENT PROCESS ---
            printf("[Parent] Created child process with PID: %d\n", pid);
            
            // Requirement 4: Allow the parent process to wait for the child using wait()
            pid_t terminated_child = wait(&status);
            
            if (terminated_child > 0) {
                if (WIFEXITED(status)) {
                    printf("[Parent] Child process %d terminated normally with exit status %d.\n", 
                           terminated_child, WEXITSTATUS(status));
                } else {
                    printf("[Parent] Child process %d terminated abnormally.\n", terminated_child);
                }
            }
            printf("--------------------------------------------------\n");
        }
    }

    return 0;
}
